The path prompt's title and filters (gpui-pre 0003) on the file open dialog: `SetTitle`, and `SetFileTypes` with the
first type chosen (`*.ext;*.ext` for each filter, `*.*` for a filter with no extensions); a folder dialog takes no
types.

--- a/src/platform.rs
+++ b/src/platform.rs
@@ -1605,6 +1605,41 @@
             folder_dialog.SetOkButtonLabel(&HSTRING::from(prompt))?;
         }
 
+        if let Some(title) = options.title {
+            let title: &str = &title;
+            folder_dialog.SetTitle(&HSTRING::from(title))?;
+        }
+
+        // the strings stay alive while the dialog reads the specs that point at them
+        let filters: Vec<(HSTRING, HSTRING)> = options
+            .filters
+            .iter()
+            .filter(|_| !options.directories)
+            .map(|filter| {
+                let spec = if filter.extensions.is_empty() {
+                    "*.*".to_owned()
+                } else {
+                    filter
+                        .extensions
+                        .iter()
+                        .map(|extension| format!("*.{extension}"))
+                        .join(";")
+                };
+                (HSTRING::from(filter.name.as_str()), HSTRING::from(spec))
+            })
+            .collect();
+        if !filters.is_empty() {
+            let specs: Vec<Common::COMDLG_FILTERSPEC> = filters
+                .iter()
+                .map(|(name, spec)| Common::COMDLG_FILTERSPEC {
+                    pszName: PCWSTR(name.as_ptr()),
+                    pszSpec: PCWSTR(spec.as_ptr()),
+                })
+                .collect();
+            folder_dialog.SetFileTypes(&specs)?;
+            folder_dialog.SetFileTypeIndex(1)?;
+        }
+
         if let Err(error) = folder_dialog.Show(window) {
             if error.code() == HRESULT::from_win32(ERROR_CANCELLED.0) {
                 return Ok(None);
