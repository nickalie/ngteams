+    #[test]
+    fn a_right_to_left_line_is_a_right_to_left_paragraph_from_x_zero() -> Result<()> {
+        let text_system = DirectWriteTextSystem::new()?;
+        let font_id = text_system.font_id(&Font {
+            family: "Segoe UI".into(),
+            ..Default::default()
+        })?;
+        let layout = |text: &str| {
+            text_system.layout_line(
+                text,
+                px(16.),
+                &[FontRun {
+                    len: text.len(),
+                    font_id,
+                }],
+            )
+        };
+        let glyph_at = |layout: &LineLayout, index: usize| {
+            layout
+                .runs
+                .iter()
+                .flat_map(|run| &run.glyphs)
+                .find(|glyph| glyph.index == index)
+                .map(|glyph| glyph.id)
+        };
+        let brackets = layout("()");
+        let closing = glyph_at(&brackets, 1);
+        assert!(closing.is_some() && closing != glyph_at(&brackets, 0));
+        // in a right-to-left paragraph, the bracket between the Hebrew word and the English one is mirrored
+        let text = "\u{5e9}\u{5dc}\u{5d5}\u{5dd} (hello)";
+        let mixed = layout(text);
+        assert_eq!(
+            glyph_at(&mixed, text.find('(').unwrap_or_default()),
+            closing,
+            "{mixed:?}"
+        );
+        assert_eq!(
+            glyph_at(&mixed, text.find(')').unwrap_or_default()),
+            glyph_at(&brackets, 0),
+            "{mixed:?}"
+        );
+        for text in [text, "\u{5e9}\u{5dc}\t\u{5d5}\u{5dd} (hello)"] {
+            let line = layout(text);
+            for glyph in line.runs.iter().flat_map(|run| &run.glyphs) {
+                let x = glyph.position.x;
+                assert!(
+                    x >= px(-0.5) && x < line.width,
+                    "{glyph:?} of {:?}",
+                    line.width
+                );
+            }
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn right_to_left_runs_keep_native_advances_in_visual_order() -> Result<()> {
+        let text_system = DirectWriteTextSystem::new()?;
+        let font_id = text_system.font_id(&Font {
+            family: "Segoe UI".into(),
+            ..Default::default()
+        })?;
+        let layout = |text: &str| {
+            text_system.layout_line(
+                text,
+                px(16.),
+                &[FontRun {
+                    len: text.len(),
+                    font_id,
+                }],
+            )
+        };
+        // each text with the positions of its characters from left to right
+        for (text, visual) in [
+            ("\u{5d0}\u{5d1}", &[1, 0][..]),
+            ("a\u{5d0}\u{5d1}b", &[0, 2, 1, 3]),
+            ("a\t\u{5d0}\u{5d1}\tb", &[0, 1, 3, 2, 4, 5]),
+            ("\u{5e9}\u{5dc}\t\u{5d5}\u{5dd}", &[4, 3, 2, 1, 0]),
+        ] {
+            let line = layout(text);
+            let characters = text.char_indices().collect::<Vec<_>>();
+            let x_of = |index: usize| {
+                line.runs
+                    .iter()
+                    .flat_map(|run| &run.glyphs)
+                    .find(|glyph| glyph.index == index)
+                    .map(|glyph| glyph.position.x)
+            };
+            let mut expected_x = px(0.0);
+            for &position in visual {
+                let (index, character) = characters[position];
+                let x = x_of(index);
+                if character == '\t' {
+                    let x = x.unwrap_or_default();
+                    assert!(
+                        (x - expected_x).abs() < px(0.01),
+                        "{text:?}, index={index}: expected {expected_x:?}, got {x:?}, {line:?}"
+                    );
+                    // the tab ends where the next character starts
+                    expected_x = visual
+                        .iter()
+                        .skip_while(|&&next| next != position)
+                        .nth(1)
+                        .and_then(|&next| x_of(characters[next].0))
+                        .unwrap_or(line.width);
+                    assert!(expected_x > x, "{text:?}, index={index}, {line:?}");
+                    continue;
+                }
+                assert!(
+                    x.is_some_and(|x| (x - expected_x).abs() < px(0.01)),
+                    "{text:?}, index={index}: expected {expected_x:?}, got {x:?}, {line:?}"
+                );
+                expected_x += layout(&character.to_string()).width;
+            }
+            assert!(
+                (line.width - expected_x).abs() < px(0.01),
+                "{text:?}: {line:?}"
+            );
+        }
+        Ok(())
+    }
