The test platform's window gives its title back, so a test can check what the window is titled.

diff --git a/src/platform/test/window.rs b/src/platform/test/window.rs
index 5692b1e7..7bd78d1c 100644
--- a/src/platform/test/window.rs
+++ b/src/platform/test/window.rs
@@ -444,6 +444,10 @@ impl PlatformWindow for TestWindow {
         self.0.lock().title = Some(title.to_owned());
     }
 
+    fn get_title(&self) -> String {
+        self.0.lock().title.clone().unwrap_or_default()
+    }
+
     fn set_app_id(&mut self, _app_id: &str) {}
 
     fn set_background_appearance(&self, _background: WindowBackgroundAppearance) {}
