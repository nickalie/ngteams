A title and file filters for the path prompt: `PathPromptOptions` gains `title` (the dialog's title, else the
platform's own "Open File") and `filters` (`PathPromptFilter`: a name, the file name extensions and the MIME types; the
first one chosen when the dialog opens, every file when there are none), and `Default`. The platforms read them:
gpui-pre-linux (0005) and gpui-pre-windows (0002). The macOS panel still shows every file. An upstream candidate
(Zed).

--- a/src/platform.rs
+++ b/src/platform.rs
@@ -3021,7 +3021,7 @@
 }
 
 /// The options that can be configured for a file dialog prompt
-#[derive(Clone, Debug)]
+#[derive(Clone, Debug, Default)]
 pub struct PathPromptOptions {
     /// Should the prompt allow files to be selected?
     pub files: bool,
@@ -3031,6 +3031,21 @@
     pub multiple: bool,
     /// The prompt to show to a user when selecting a path
     pub prompt: Option<SharedString>,
+    /// The title of the dialog; the platform's own title when `None`
+    pub title: Option<SharedString>,
+    /// The kinds of file the dialog offers, the first one chosen when it opens; every file when empty
+    pub filters: Vec<PathPromptFilter>,
+}
+
+/// A kind of file that a file dialog prompt offers
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PathPromptFilter {
+    /// The name that the dialog shows for this kind of file
+    pub name: SharedString,
+    /// The extensions of the file names, without the dot (`png`); every file when empty
+    pub extensions: Vec<SharedString>,
+    /// The MIME types of the files (`image/png`), where the platform matches files by their type
+    pub mime_types: Vec<SharedString>,
 }
 
