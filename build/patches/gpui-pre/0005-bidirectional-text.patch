+                    window.paint_quad(fill(
+                        Bounds {
+                            origin: point(*left + segment.x, top),
+                            size: size(segment.width, line_height),
+                        },
+                        background,
+                    ));
+                }
+            }
+        }
+        Ok(())
+    })
