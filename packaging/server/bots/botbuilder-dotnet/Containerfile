# The Bot Framework SDK for .NET sample bot, run by ngteams-server's container tests; pinned by packages.lock.json.
# Build from packaging/server/bots: `podman build -f botbuilder-dotnet/Containerfile -t localhost/ngteams-bot-botbuilder-dotnet:1 .`
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY botbuilder-dotnet/SampleBot.csproj botbuilder-dotnet/packages.lock.json ./
RUN dotnet restore --locked-mode
COPY botbuilder-dotnet/Program.cs botbuilder-dotnet/SampleBot.cs botbuilder-dotnet/appsettings.json ./
RUN dotnet publish --no-restore -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /bot
COPY --from=build /out ./
COPY --chmod=755 botbuilder-dotnet/run.sh ./
COPY --chmod=755 entrypoint.sh /entrypoint.sh
USER app
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bot/run.sh"]
