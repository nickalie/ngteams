# The Microsoft 365 Agents SDK (JavaScript) sample bot, run by ngteams-server's container tests; pinned by the lock.
# Build from packaging/server/bots: `podman build -f agents/Containerfile -t localhost/ngteams-bot-agents:1 .`
FROM docker.io/library/node:22-slim
WORKDIR /bot
COPY agents/package.json agents/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY agents/bot.js ./
COPY --chmod=755 entrypoint.sh /entrypoint.sh
USER node
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "bot.js"]
